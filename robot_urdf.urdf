<!--Choose a name space and start xacro-->
<robot name="differential_drive_robot">
  <!--Define the parameters for the differential drive mobile robot-->
  <!--All units are SI-Units-->
  <!--Origin rotation of the chassis-->
  <!--Origin rotation of the wheel joints-->
  <!--Rotation of the caster wheels-->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4235294117647059 0.0392156862745098 1.0"/>
  </material>
  <material name="brown">
    <color rgba="0.8705882352941177 0.8117647058823529 0.7647058823529411 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <!-- <xacro:include filename="$(find rvc_simulation_environment)/models/robot_vacuum_cleaner/parameter.xacro" /> -->
  <!-- TODO: Add same update rates over parameter setting and define all parameters in config -->
  <!-- Differential Drive controller from Gazebo, TODO: Add noise by adapting the plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="differential_drive_controller">
      <alwaysOn>true</alwaysOn>
      <!-- Plugin update rate in Hz -->
      <updateRate>10</updateRate>
      <!-- Name of left joint, defaults to `left_joint` -->
      <leftJoint>base_link_to_left_wheel</leftJoint>
      <!-- Name of right joint, defaults to `right_joint` -->
      <rightJoint>base_link_to_right_wheel</rightJoint>
      <!-- The distance from the center of one wheel to the other, in meters, defaults to 0.34 m -->
      <wheelSeparation>0.5315</wheelSeparation>
      <!-- Diameter of the wheels, in meters, defaults to 0.15 m -->
      <wheelDiameter>0.21</wheelDiameter>
      <!-- Wheel acceleration, in rad/s^2, defaults to 0.0 rad/s^2 -->
      <wheelAcceleration>2.0</wheelAcceleration>
      <!-- Maximum torque which the wheels can produce, in Nm, defaults to 5 Nm -->
      <wheelTorque>5.0</wheelTorque>
      <!-- Topic to receive geometry_msgs/Twist message commands, defaults to `cmd_vel` -->
      <commandTopic>cmd_vel</commandTopic>
      <!-- Topic to publish nav_msgs/Odometry messages, defaults to `odom` -->
      <odometryTopic>odom</odometryTopic>
      <!-- Odometry frame, defaults to `odom` -->
      <odometryFrame>odom_link</odometryFrame>
      <!-- Robot frame to calculate odometry from, defaults to `base_footprint` -->
      <robotBaseFrame>base_link</robotBaseFrame>
      <!-- Odometry source, 0 for ENCODER, 1 for WORLD, defaults to WORLD -->
      <!-- <odometrySource>1</odometrySource> -->
      <!-- Set to true to publish transforms for the wheel links, defaults to false -->
      <!-- <publishWheelTF>true</publishWheelTF> -->
      <!-- Set to true to publish transforms for the odometry, defaults to true -->
      <!-- <publishOdom>true</publishOdom> -->
      <!-- Set to true to publish sensor_msgs/JointState on /joint_states for the wheel joints, defaults to false -->
      <!-- <publishWheelJointState>false</publishWheelJointState> -->
      <!-- Set to true to swap right and left wheels, defaults to true -->
      <legacyMode>true</legacyMode>
    </plugin>
  </gazebo>
  <!--Hukuyo Laser Plugin-->
  <gazebo reference="laser_scanner_link">
    <sensor name="hokuyo_laser_scanner_head" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>False</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <!-- <samples>${numb_of_samples}</samples> -->
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.5707963267948966</min_angle>
            <max_angle>1.5707963267948966</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.123</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.456</mean>
          <stddv>0.789</stddv>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_laser.so" name="gazebo_ros_head_hokuyo_controller">
        <topicName>/scan</topicName>
        <frameName>laser_scanner_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  <!--Define the colors of the robot components-->
  <!--Orange box-->
  <gazebo reference="chassis_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <!--Black Caster Wheels-->
  <gazebo reference="caster_wheel_front_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="caster_wheel_back_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/Black</material>
  </gazebo>
  <!--Black Left Wheel-->
  <gazebo reference="left_wheel_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  <!--Black Right Wheel-->
  <gazebo reference="right_wheel_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  <!--Black Right Wheel-->
  <gazebo reference="laser_scanner_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <!--____________________________________________________________________________________________________________________________________________________________________-->
  <!--Define Chassis______________________________________________________________________________________________________________________________________________________-->
  <!--Create a dummy link as a base link-->
  <link name="base_link">
    <pose>0 0 0 0 0 0 </pose>
  </link>
  <!--The joint between the chassis of the robot and the base of the robot -->
  <joint name="base_link_to_chassis" type="fixed">
    <child link="chassis_link"/>
    <parent link="base_link"/>
  </joint>
  <!-- Define the chassis of the differential drive robot, which is our base -->
  <link name="chassis_link">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.105"/>
      <geometry>
        <cylinder length="0.15" radius="0.25"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.105"/>
      <geometry>
        <cylinder length="0.15" radius="0.25"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.105"/>
      <mass value="42.411500823462205"/>
      <inertia ixx="0.7422012644105885" ixy="0" ixz="0" iyy="0.7422012644105885" iyz="0" izz="1.325359400733194"/>
    </inertial>
  </link>
  <!--Joint betweeb chassis (cylinder) and caster wheel (sphere) -->
  <joint name="chassis_to_caster_wheel_front" type="fixed">
    <parent link="chassis_link"/>
    <child link="caster_wheel_front_link"/>
  </joint>
  <!--The definition of the caster wheel which is simulated by a sphere-->
  <link name="caster_wheel_front_link">
    <collision>
      <origin rpy="0 0 0" xyz="0.1875 0 0.02625"/>
      <geometry>
        <sphere radius="0.02625"/>
      </geometry>
      <!-- <surface>
                <friction>
                    <ode>
                        <mu>0</mu>
                        <mu2>0</mu2>
                        <slip1>1.0</slip1>
                        <slip2>1.0</slip2>
                    </ode>
                </friction>
            </surface> -->
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0.1875 0 0.02625"/>
      <geometry>
        <sphere radius="0.02625"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0.1875 0 0.02625"/>
      <mass value="0.1091035858683565"/>
      <inertia ixx="3.0071675854965757e-05" ixy="0" ixz="0" iyy="3.0071675854965757e-05" iyz="0" izz="3.0071675854965757e-05"/>
    </inertial>
  </link>
  <!--Joint betweeb chassis (cylinder) and caster wheel (sphere) -->
  <joint name="chassis_to_caster_wheel_back" type="fixed">
    <parent link="chassis_link"/>
    <child link="caster_wheel_back_link"/>
  </joint>
  <!--The definition of the caster wheel which is simulated by a sphere-->
  <link name="caster_wheel_back_link">
    <collision>
      <origin rpy="0 0 0" xyz="-0.1875 0 0.02625"/>
      <geometry>
        <sphere radius="0.02625"/>
      </geometry>
      <!-- <surface>
                <friction>
                    <ode>
                        <mu>0</mu>
                        <mu2>0</mu2>
                        <slip1>1.0</slip1>
                        <slip2>1.0</slip2>
                    </ode>
                </friction>
            </surface> -->
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="-0.1875 0 0.02625"/>
      <geometry>
        <sphere radius="0.02625"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.1875 0 0.02625"/>
      <mass value="0.1091035858683565"/>
      <inertia ixx="3.0071675854965757e-05" ixy="0" ixz="0" iyy="3.0071675854965757e-05" iyz="0" izz="3.0071675854965757e-05"/>
    </inertial>
  </link>
  <!--Define the left wheel link of the differential drive mobile robot-->
  <link name="left_wheel_link">
    <collision>
      <origin rpy="0 1.5707963267948966 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.105"/>
      </geometry>
      <surface>
        <!--Reibung-->
        <friction>
          <ode>
            <!--Reibungskoeffizienten-->
            <mu>1.0</mu>
            <mu2>1.0</mu2>
            <!--Schlupf-->
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual>
      <origin rpy="0 1.5707963267948966 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.105"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin rpy="0 1.5707963267948966 1.5707963267948966" xyz="0 0 0"/>
      <mass value="1.571091636504334"/>
      <inertia ixx="0.004460230962808522" ixy="0" ixz="0" iyy="0.004460230962808522" iyz="0" izz="0.00866064264623014"/>
    </inertial>
  </link>
  <!--Define the left wheel link of the differential drive mobile robot-->
  <link name="right_wheel_link">
    <collision>
      <origin rpy="0 1.5707963267948966 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.105"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual>
      <origin rpy="0 1.5707963267948966 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.105"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin rpy="0 1.5707963267948966 1.5707963267948966" xyz="0 0 0"/>
      <mass value="1.571091636504334"/>
      <inertia ixx="0.004460230962808522" ixy="0" ixz="0" iyy="0.004460230962808522" iyz="0" izz="0.00866064264623014"/>
    </inertial>
  </link>
  <!-- Set joints for the driving wheels which can be controlled over ROS -->
  <joint name="base_link_to_left_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="0 0.26575 0.105"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <child link="left_wheel_link"/>
    <parent link="base_link"/>
    <limit effort="100" velocity="100"/>
    <joint_properties damping="0.2" friction="0.05"/>
  </joint>
  <joint name="base_link_to_right_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="0 -0.26575 0.105"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <child link="right_wheel_link"/>
    <parent link="base_link"/>
    <limit effort="100" velocity="100"/>
    <joint_properties damping="0.2" friction="0.05"/>
  </joint>
  <!--____________________________________________________________________________________________________________________________________________________________________-->
  <!--Define Sensors______________________________________________________________________________________________________________________________________________________-->
  <!--Hokuyo LiDAR-Sensor-->
  <link name="laser_scanner_link">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.075" radius="0.05"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.075" radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.8482300164692441"/>
      <inertia ixx="0.0009277515805132358" ixy="0" ixz="0" iyy="0.0009277515805132358" iyz="0" izz="0.0010602875205865552"/>
    </inertial>
  </link>
  <joint name="chassis_to_laser_scanner" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.2175"/>
    <axis xyz="0 1 0"/>
    <child link="laser_scanner_link"/>
    <parent link="base_link"/>
  </joint>
</robot>

