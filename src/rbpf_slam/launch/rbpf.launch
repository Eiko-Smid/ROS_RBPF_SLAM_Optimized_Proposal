<launch>
    <!--Define useful parameters-->
    <arg name="paused" default="false"/>
    <arg name="spawn_x" default="0.0"/>
    <arg name="spawn_y" default="0.0"/>
    <arg name="spawn_z" default="0.18"/>
    <arg name="spawn_roll" default="0.0"/>
    <arg name="spawn_pitch" default="0.0"/>
    <arg name="spawn_yaw" default="0.0"/>

    <!--Launch the robot model and the world.-->
    <include file="$(find rvc_simulation_environment)/launch/robot_vacuum_cleaner.launch">
        <arg name="paused" value="$(arg paused)"/>
        <arg name="spawn_x" value="$(arg spawn_x)"/>
        <arg name="spawn_y" value="$(arg spawn_y)"/>
        <arg name="spawn_z" value="$(arg spawn_z)"/>
        <arg name="spawn_roll" value="$(arg spawn_roll)"/>
        <arg name="spawn_pitch" value="$(arg spawn_pitch)"/>
        <arg name="spawn_yaw" value="$(arg spawn_yaw)"/>
    </include>

    <!--Generate static transform between map and odom -->
    <!-- <node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 map odom_link 30" /> -->

    <!--Launch the LogOddsToOccupancyGrid algorithm that transforms the map from logOdds space to scaled probability
    space and publishes the map as nav_msgs.msg OccupancyGrid message.-->
    <node pkg="rbpf_slam" name="log_odds_map_to_occupancy_grid" type="log_odds_map_to_occupancy_grid.py" output="screen">
    </node>

    <!--Simulate Wheel Encoder data-->
    <node   pkg="rvc_commander" 
            name="wheel_encoder_simulation_node" 
            type="wheel_encoder_simulation.py" 
            output="screen">
            <param name="wheel_encoder_motion_error_factor" value="0.1"/>
            <param name="wheel_encoder_turn_error_factor" value="0.25"/>
    </node>
    
    <!--Launch the occupancy grid mapping algorithm (with known pose).-->
    <node pkg="rbpf_slam" name="rbpf_slam_node" type="rbpf_slam_node.py" output="screen">        
    </node>

    <!--Launch rviz-->
    <node pkg="rviz" name="rviz" type="rviz" args="-d $(find rbpf_slam)/rviz/ogm_rviz_cfg.rviz">
    </node>

</launch>
