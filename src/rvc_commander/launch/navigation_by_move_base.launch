<!--The launchfile for starting the motion planning ros package named "move base"-->

<launch>
    <include file="$(find rvc_commander)/launch/localization_by_amcl.launch" />

    <node pkg="move_base" type="move_base" name="move_base" output="screen" >
        <rosparam file="$(find rvc_commander)/launch/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find rvc_commander)/launch/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find rvc_commander)/launch/config/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find rvc_commander)/launch/config/global_costmap_params.yaml" command="load" />

        <param name="base_global_planner"   value="global_planner/GlobalPlanner"/>
        <rosparam file="$(find rvc_commander)/launch/config/planner_global.yaml" command="load" />

        <rosparam file="$(find rvc_commander)/launch/config/planner_teb.yaml" command="load" />
        <param name="base_local_planner"   value="teb_local_planner/TebLocalPlannerROS"/>

    </node>
</launch>