<?xml version="1.0" ?>

<sdf version="1.5">
	<world name="robot_vacuum_cleaner_world">
		<!-- A global light source -->
		<include>
			<uri>model://sun</uri>
		</include>

		<!-- A ground plane -->
		<include>
			<uri>model://ground_plane</uri>
		</include>

		<!--Include a building-->
		<include>
			<uri>model://cafe</uri>
			<pose>0 0 0 0 0 0</pose>
		</include>

	</world>
</sdf>  



