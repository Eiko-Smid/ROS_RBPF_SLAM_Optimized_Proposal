<?xml version='1.0'?>

<!--Choose a name space and start xacro-->
<robot name="differential_drive_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="laser_range_resolution" default="0.01"/>
    <xacro:arg name="laser_noise_type" default="gaussian"/>
    <xacro:arg name="laser_noise_mean" default="0.0"/>
    <xacro:arg name="laser_noise_stddv" default="0.01"/>

    <!--Including all xacro files that are needed to describe the robot model-->
    <xacro:include filename="$(find rvc_simulation_environment)/models/robot_vacuum_cleaner/parameter.xacro"/>
    <xacro:include filename="$(find rvc_simulation_environment)/models/robot_vacuum_cleaner/materials.xacro"/>
    <xacro:include filename="$(find rvc_simulation_environment)/models/robot_vacuum_cleaner/macros.xacro"/>
    <xacro:include filename="$(find rvc_simulation_environment)/models/robot_vacuum_cleaner/diff_drive.gazebo"/>
    
<!--____________________________________________________________________________________________________________________________________________________________________-->
<!--Define Chassis______________________________________________________________________________________________________________________________________________________-->

    <!--Create a dummy link as a base link-->
    <link name= "base_link">
        <pose>0 0 0 0 0 0 </pose> 
    </link>

    <!--The joint between the chassis of the robot and the base of the robot -->
    <joint type="fixed" name="base_link_to_chassis">
        <child link="chassis_link"/>
        <parent link="base_link"/>
    </joint>

    <!-- Define the chassis of the differential drive robot, which is our base -->
    <link name="chassis_link">
    <collision>
        <origin xyz="${pos_chassis}" rpy="${rot_chassis}" />
        <geometry>
            <cylinder radius="${r_chassis}" length="${h_chassis}" />
        </geometry>
    </collision>
    <visual>
        <origin xyz="${pos_chassis}" rpy="${rot_chassis}" />
        <geometry>
            <cylinder radius="${r_chassis}" length="${h_chassis}" />
        </geometry>    
        <material name="orange"/>        
    </visual>
    <inertial>
        <origin xyz="${pos_chassis}" rpy="${rot_chassis}" />
        <mass value= "${m_chassis}"/>
        <xacro:cylinder_inertia m="${m_chassis}" r="${r_chassis}" h="${h_chassis}"/> 
    </inertial>
</link>

    <!--Joint betweeb chassis (cylinder) and caster wheel (sphere) -->
    <joint name="chassis_to_caster_wheel_front" type="fixed">
        <parent link="chassis_link"/>
        <child link="caster_wheel_front_link"/>
    </joint>

    <!--The definition of the caster wheel which is simulated by a sphere-->
    <link name='caster_wheel_front_link'>
        <collision>
            <origin xyz="${pos_f_caster_wheel}" rpy="${rot_caster_wheel}"/>
            <geometry>
                <sphere radius="${r_caster_wheel}"/>
            </geometry>
            <!-- <surface>
                <friction>
                    <ode>
                        <mu>0</mu>
                        <mu2>0</mu2>
                        <slip1>1.0</slip1>
                        <slip2>1.0</slip2>
                    </ode>
                </friction>
            </surface> -->
        </collision>
        <visual>
            <origin xyz="${pos_f_caster_wheel}" rpy="${rot_caster_wheel}"/>
            <geometry>
                <sphere radius="${r_caster_wheel}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <inertial>
            <origin xyz="${pos_f_caster_wheel}" rpy="${rot_caster_wheel}"/>
            <mass value= "${m_caster_wheel}"/>
            <xacro:sphere_inertia m="${m_caster_wheel}" r="${r_caster_wheel}"/> 
        </inertial>
    </link>

    <!--Joint betweeb chassis (cylinder) and caster wheel (sphere) -->
    <joint name="chassis_to_caster_wheel_back" type="fixed">
        <parent link="chassis_link"/>
        <child link="caster_wheel_back_link"/>
    </joint>

    <!--The definition of the caster wheel which is simulated by a sphere-->
    <link name='caster_wheel_back_link'>
        <collision>
            <origin xyz="${pos_b_caster_wheel}" rpy="${rot_caster_wheel}"/>
            <geometry>
                <sphere radius="${r_caster_wheel}"/>
            </geometry>
            <!-- <surface>
                <friction>
                    <ode>
                        <mu>0</mu>
                        <mu2>0</mu2>
                        <slip1>1.0</slip1>
                        <slip2>1.0</slip2>
                    </ode>
                </friction>
            </surface> -->
        </collision>
        <visual>
            <origin xyz="${pos_b_caster_wheel}" rpy="${rot_caster_wheel}"/>
            <geometry>
                <sphere radius="${r_caster_wheel}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <inertial>
            <origin xyz="${pos_b_caster_wheel}" rpy="${rot_caster_wheel}"/>
            <mass value= "${m_caster_wheel}"/>
            <xacro:sphere_inertia m="${m_caster_wheel}" r="${r_caster_wheel}"/> 
        </inertial>
    </link>

    <!--Define the left wheel link of the differential drive mobile robot-->
    <link name="left_wheel_link">
        <collision>
            <origin xyz="${pos_l_wheel}" rpy="${rot_wheel}" />
            <geometry>
                <cylinder radius="${r_wheel}" length="${w_wheel}" />
            </geometry>
            <surface>
                <!--Reibung-->
                <friction>
                    <ode>
                        <!--Reibungskoeffizienten-->
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                        <!--Schlupf-->
                        <slip1>0.0</slip1>
                        <slip2>0.0</slip2>
                    </ode>
                </friction>
            </surface>                
        </collision>
        <visual>
            <origin xyz="${pos_l_wheel}" rpy="${rot_wheel}" />
            <geometry>
                <cylinder radius="${r_wheel}" length="${w_wheel}" />
            </geometry>    
            <material name="black"/>        
        </visual>
        <inertial>
            <origin xyz="${pos_l_wheel}" rpy="${rot_wheel}" />
            <mass value= "${m_wheel}"/>
            <xacro:cylinder_inertia m="${m_wheel}" r="${r_wheel}" h="${w_wheel}"/> 
        </inertial>
    </link>

    <!--Define the left wheel link of the differential drive mobile robot-->
    <link name="right_wheel_link">
        <collision>
            <origin xyz="${pos_r_wheel}" rpy="${rot_wheel}" />
            <geometry>
                <cylinder radius="${r_wheel}" length="${w_wheel}" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                        <slip1>0.0</slip1>
                        <slip2>0.0</slip2>
                    </ode>
                </friction>
            </surface>                
        </collision>
        <visual>
            <origin xyz="${pos_r_wheel}" rpy="${rot_wheel}" />
            <geometry>
                <cylinder radius="${r_wheel}" length="${w_wheel}" />
            </geometry>    
            <material name="black"/>        
        </visual>
        <inertial>
            <origin xyz="${pos_r_wheel}" rpy="${rot_wheel}" />
            <mass value= "${m_wheel}"/>
            <xacro:cylinder_inertia m="${m_wheel}" r="${r_wheel}" h="${w_wheel}"/> 
        </inertial>
    </link>
    
    <!-- Set joints for the driving wheels which can be controlled over ROS -->
    <joint name="base_link_to_left_wheel" type="continuous" >
        <origin xyz="${joint_pos_l_wheel}" rpy="${joint_rot_wheel}"/>
        <axis xyz="0 1 0" rpy="0 0 0"/>
        <child link="left_wheel_link"/>
        <parent link="base_link"/>
        <limit effort="100" velocity="100"/>
        <joint_properties damping="0.2" friction="0.05"/>
    </joint>

    <joint name="base_link_to_right_wheel" type="continuous">
        <origin xyz="${joint_pos_r_wheel}" rpy="${joint_rot_wheel}"/>
        <axis xyz="0 1 0" rpy="0 0 0"/>
        <child link="right_wheel_link"/>
        <parent link="base_link"/>
        <limit effort="100" velocity="100"/>
        <joint_properties damping="0.2" friction="0.05"/>
    </joint>


<!--____________________________________________________________________________________________________________________________________________________________________-->
<!--Define Sensors______________________________________________________________________________________________________________________________________________________-->


    <!--Hokuyo LiDAR-Sensor-->
    <link name="laser_scanner_link">
        <collision>
            <origin xyz= "${pos_laser_scanner}" rpy="${rot_laser_scanner}"/>
            <geometry>
                <cylinder radius="${r_laser_scanner}" length="${h_laser_scanner}" />
            </geometry>
        </collision>
        <visual>
            <origin xyz= "${pos_laser_scanner}" rpy="${rot_laser_scanner}"/>
            <geometry>
                <cylinder radius="${r_laser_scanner}" length="${h_laser_scanner}" />
            </geometry>
            <material name="blue"/>   
        </visual>
        <inertial>
            <origin xyz= "${pos_laser_scanner}" rpy="${rot_laser_scanner}"/>
            <mass value="${m_laser_scanner}"/>
            <xacro:cylinder_inertia m="${m_laser_scanner}" r="${r_laser_scanner}" h="${h_laser_scanner}" />
        </inertial>
    </link>

    <joint name="chassis_to_laser_scanner" type="fixed">
        <origin xyz="${joint_pos_laser_scanner}" rpy="${joint_rot_laser_scanner}"/>
        <axis xyz="${joint_axis_laser_scanner}"/>
        <child link="laser_scanner_link"/>
        <parent link="base_link"/>
    </joint>


</robot>